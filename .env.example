# Salin file ini menjadi ".env" lalu isi nilainya.
# File .env sudah masuk .gitignore, jadi tidak akan ter-upload ke GitHub.

# --- Garmin (Personal API resmi) ---
GARMIN_PERSONAL_API_KEY=

# --- Supabase ---
# Project Settings > API. Pakai "secret key" / "service_role key", BUKAN anon/publishable key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=
# Opsional. "gemini-flash-latest" otomatis mengikuti model Flash terbaru.
GEMINI_MODEL=gemini-flash-latest
# Dipakai kalau model utama gagal (mis. server sedang penuh).
GEMINI_MODEL_CADANGAN=gemini-flash-lite-latest

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Fitur ---
# true = tampilkan budget makan di laporan dan aktifkan /catat, /sisa, /budget, /batal
FITUR_BUDGET=false

# --- Preferensi pribadi (boleh diubah kapan saja) ---
KOTA=Jakarta
# Contoh: "halal, tidak suka pare, alergi udang, lebih sering beli di warung"
CATATAN_MAKANAN=halal, lebih sering beli di warung
# Contoh: "lari 3-4x seminggu, sedang persiapan 10K"
CATATAN_OLAHRAGA=lari 3x seminggu
